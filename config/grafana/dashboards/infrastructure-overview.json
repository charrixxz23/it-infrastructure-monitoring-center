    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Una serie por volumen lógico, agrupada por mountpoint. Se omiten device, fstype, instance y job para que variaciones de etiquetas no dupliquen volúmenes; max conserva el mayor porcentaje de uso si varias series representan el mismo punto de montaje. Se excluyen /dev/loop*, tmpfs, overlay, squashfs, proc, sysfs, cgroup*, nsfs y devtmpfs. Windows C: corresponde a /mnt/host/c (9p); Docker virtual disk corresponde a /mnt/docker-desktop-disk (ext4).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 14,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 3,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "decimals": 1,
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "id": 10,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "label_replace(label_replace(max by (mountpoint) (100 * (1 - (node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=~\"^(/mnt/host/c|/mnt/docker-desktop-disk)$\",device!~\"^/dev/loop.*$\",fstype!~\"^(tmpfs|overlay|squashfs|proc|sysfs|cgroup.*|nsfs|devtmpfs)$\"} / node_filesystem_size_bytes{job=\"node-exporter\",mountpoint=~\"^(/mnt/host/c|/mnt/docker-desktop-disk)$\",device!~\"^/dev/loop.*$\",fstype!~\"^(tmpfs|overlay|squashfs|proc|sysfs|cgroup.*|nsfs|devtmpfs)$\"}))), \"volume\", \"Windows C:\", \"mountpoint\", \"^/mnt/host/c$\"), \"volume\", \"Docker virtual disk\", \"mountpoint\", \"^/mnt/docker-desktop-disk$\")",
          "instant": false,
          "legendFormat": "{{volume}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Filesystem Utilization",
      "type": "timeseries"
    },
