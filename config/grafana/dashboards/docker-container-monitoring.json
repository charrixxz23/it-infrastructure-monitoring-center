{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Estadísticas de recursos de los contenedores en ejecución del proyecto Compose, consultadas por un exporter Python local. No es un inventario de todos los contenedores del motor. En Docker Desktop/WSL2 las cifras pertenecen al motor Linux.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Cantidad del último snapshot completo del proyecto Compose. 0 significa colección correcta sin contenedores observados; NO DATA indica ausencia de muestra o colección incompleta.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "min": 0,
          "noValue": "NO DATA",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "max(itmc_container_exporter_observed_containers{job=\"container-exporter\"} and on(job,instance) (itmc_container_exporter_collection_success{job=\"container-exporter\"} == 1) and on(job,instance) (up{job=\"container-exporter\"} == 1))", "instant": true, "legendFormat": "", "range": false, "refId": "A" }],
      "title": "Compose Containers Observed",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Suma del porcentaje de CPU reportado por Docker CLI para las muestras disponibles. Puede superar 100 % cuando los contenedores consumen varios núcleos.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(itmc_container_cpu_usage_percent{job=\"container-exporter\"} and on(job,instance) (itmc_container_exporter_collection_success{job=\"container-exporter\"} == 1) and on(job,instance) (up{job=\"container-exporter\"} == 1))", "instant": true, "legendFormat": "", "range": false, "refId": "A" }],
      "title": "Total CPU Usage",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Memoria usada agregada según el resumen de Docker CLI; el límite puede representar la memoria asignada al motor Docker Desktop.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "decimals": 1, "min": 0, "unit": "bytes" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(itmc_container_memory_usage_bytes{job=\"container-exporter\"} and on(job,instance) (itmc_container_exporter_collection_success{job=\"container-exporter\"} == 1) and on(job,instance) (up{job=\"container-exporter\"} == 1))", "instant": true, "legendFormat": "", "range": false, "refId": "A" }],
      "title": "Total Memory Used",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Tráfico recibido agregado a partir de contadores acumulados de Docker stats.",
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "decimals": 2, "min": 0, "unit": "binBps" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(rate(itmc_container_network_receive_bytes_total{job=\"container-exporter\"}[$__rate_interval]) and on(job,instance) (itmc_container_exporter_collection_success{job=\"container-exporter\"} == 1) and on(job,instance) (up{job=\"container-exporter\"} == 1))", "instant": true, "legendFormat": "", "range": false, "refId": "A" }],
      "title": "Network RX",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Tráfico transmitido agregado a partir de contadores acumulados de Docker stats.",
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" }, "decimals": 2, "min": 0, "unit": "binBps" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(rate(itmc_container_network_transmit_bytes_total{job=\"container-exporter\"}[$__rate_interval]) and on(job,instance) (itmc_container_exporter_collection_success{job=\"container-exporter\"} == 1) and on(job,instance) (up{job=\"container-exporter\"} == 1))", "instant": true, "legendFormat": "", "range": false, "refId": "A" }],
      "title": "Network TX",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Estado actual de scraping Prometheus agregado con min (DOWN prevalece). UP solo confirma que el endpoint responde; sin serie, Grafana muestra NO DATA.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "max": 1,
          "min": 0,
          "noValue": "NO DATA",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "unit": "short",
          "mappings": [{ "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }]
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "min(up{job=\"container-exporter\"})", "instant": true, "legendFormat": "", "range": false, "refId": "A" }],
      "title": "Exporter Health",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Porcentaje de CPU muestreado por contenedor. El nombre visible usa servicio Compose e ID corto; no se exportan nombres completos de contenedor.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "decimals": 2, "min": 0, "unit": "percent", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never", "spanNulls": false } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 7,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "itmc_container_cpu_usage_percent{job=\"container-exporter\"} and on(job,instance) (itmc_container_exporter_collection_success{job=\"container-exporter\"} == 1) and on(job,instance) (up{job=\"container-exporter\"} == 1)", "instant": false, "legendFormat": "{{service}} · {{container_id}}", "range": true, "refId": "A" }],
      "title": "CPU Usage by Container",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Bytes de memoria usados según Docker CLI, una serie por servicio e ID corto.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "decimals": 2, "min": 0, "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never", "spanNulls": false } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 8,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "itmc_container_memory_usage_bytes{job=\"container-exporter\"} and on(job,instance) (itmc_container_exporter_collection_success{job=\"container-exporter\"} == 1) and on(job,instance) (up{job=\"container-exporter\"} == 1)", "instant": false, "legendFormat": "{{service}} · {{container_id}}", "range": true, "refId": "A" }],
      "title": "Memory Usage by Container",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Tasas RX/TX calculadas con rate() sobre contadores acumulados de Docker CLI. Si el motor o la red del contenedor no reporta contadores, esas series no aparecen.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "decimals": 2, "min": 0, "unit": "binBps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": false } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 9,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "rate(itmc_container_network_receive_bytes_total{job=\"container-exporter\"}[$__rate_interval]) and on(job,instance) (itmc_container_exporter_collection_success{job=\"container-exporter\"} == 1) and on(job,instance) (up{job=\"container-exporter\"} == 1)", "instant": false, "legendFormat": "{{service}} · {{container_id}} RX", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "rate(itmc_container_network_transmit_bytes_total{job=\"container-exporter\"}[$__rate_interval]) and on(job,instance) (itmc_container_exporter_collection_success{job=\"container-exporter\"} == 1) and on(job,instance) (up{job=\"container-exporter\"} == 1)", "instant": false, "legendFormat": "{{service}} · {{container_id}} TX", "range": true, "refId": "B" }
      ],
      "title": "Network Throughput by Container",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Muestra solo las últimas muestras recibidas para contenedores que el exporter observó en el proyecto Compose. No es inventario completo del daemon.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 1, "min": 0, "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 120 }] } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 20 },
      "id": 10,
      "options": { "cellHeight": "sm", "showHeader": true, "sortBy": [{ "displayName": "Value", "desc": true }] },
      "targets": [{ "editorMode": "code", "expr": "time() - itmc_container_last_observed_timestamp_seconds{job=\"container-exporter\"} and on(job,instance) (itmc_container_exporter_collection_success{job=\"container-exporter\"} == 1) and on(job,instance) (up{job=\"container-exporter\"} == 1)", "format": "table", "instant": true, "legendFormat": "", "range": false, "refId": "A" }],
      "title": "Container Observation Age",
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Segundos desde la última colección Docker completa. Aumenta si el proceso responde pero falla el acceso al Engine; NO DATA indica que Prometheus no puede consultar el target.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 0, "min": 0, "noValue": "NO DATA", "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 120 }] } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 20 },
      "id": 11,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "max((time() - itmc_container_exporter_last_success_timestamp_seconds{job=\"container-exporter\"}) and on(job,instance) (up{job=\"container-exporter\"} == 1))", "instant": true, "legendFormat": "", "range": false, "refId": "A" }],
      "title": "Last Complete Sample Age",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "OK confirma que Docker CLI terminó una colección completa; ERROR refleja una colección fallida/parcial mientras el target responde. Si el target no tiene muestra, muestra NO DATA y Exporter Health distingue DOWN.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "max": 1,
          "min": 0,
          "noValue": "NO DATA",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "unit": "short",
          "mappings": [{ "options": { "0": { "text": "ERROR", "color": "red" }, "1": { "text": "OK", "color": "green" } }, "type": "value" }]
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 20 },
      "id": 12,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "min(itmc_container_exporter_collection_success{job=\"container-exporter\"} and on(job,instance) (up{job=\"container-exporter\"} == 1))", "instant": true, "legendFormat": "", "range": false, "refId": "A" }],
      "title": "Docker Stats Collection",
      "type": "stat"
    }
  ],
