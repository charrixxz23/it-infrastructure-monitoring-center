---
import "../styles/site.css";

const repository = "https://github.com/charrixxz23/it-infrastructure-monitoring-center";
const repositoryDocs = `${repository}/blob/main/docs`;
const repositoryMain = `${repository}/blob/main`;
const release = `${repository}/releases/tag/v1.0.0`;
const ciRun = `${repository}/actions/runs/40116633928`;

const screenshots = [
  {
    src: "/screenshots/01-infrastructure-overview.png",
    titleEs: "IT Infrastructure Overview",
    titleEn: "IT Infrastructure Overview",
    categoryEs: "Grafana · 14 paneles",
    categoryEn: "Grafana · 14 panels",
    descriptionEs: "KPIs de capacidad, tendencias del host Linux del motor Docker/WSL2 y salud de los dos targets de infraestructura.",
    descriptionEn: "Capacity KPIs, Docker Engine/WSL2 Linux host trends, and health for the two infrastructure targets.",
    altEs: "Captura auténtica del dashboard IT Infrastructure Overview con 14 paneles y los volúmenes Windows C: y Docker virtual disk.",
    altEn: "Authentic IT Infrastructure Overview dashboard screenshot with 14 panels and Windows C: and Docker virtual disk volumes.",
    width: 2544,
    height: 1393,
    featured: true,
  },
  {
    src: "/screenshots/02-docker-container-monitoring.png",
    titleEs: "Docker Container Monitoring",
    titleEn: "Docker Container Monitoring",
    categoryEs: "Grafana · 12 paneles",
    categoryEn: "Grafana · 12 panels",
    descriptionEs: "Cinco contenedores observados por el exporter host-side, junto a CPU, memoria, red y frescura de la muestra.",
    descriptionEn: "Five containers observed by the host-side exporter, with CPU, memory, network, and sample freshness.",
    altEs: "Captura auténtica del dashboard Docker Container Monitoring: cinco contenedores observados, exporter UP y colección Docker Stats OK.",
    altEn: "Authentic Docker Container Monitoring dashboard screenshot: five containers observed, exporter UP, and Docker Stats Collection OK.",
    width: 2532,
    height: 1405,
    featured: true,
  },
  {
    src: "/screenshots/03-prometheus-targets.png",
    titleEs: "Prometheus Targets",
    titleEn: "Prometheus Targets",
    categoryEs: "Prometheus · scrape health",
    categoryEn: "Prometheus · scrape health",
    descriptionEs: "La captura muestra 3/3 targets UP; incluye container-exporter además de Prometheus y Node Exporter.",
    descriptionEn: "The capture shows 3/3 targets UP, including container-exporter alongside Prometheus and Node Exporter.",
    altEs: "Captura auténtica de Prometheus Targets, con los targets container-exporter, node-exporter y prometheus en estado UP.",
    altEn: "Authentic Prometheus Targets screenshot showing container-exporter, node-exporter, and prometheus as UP.",
    width: 2559,
    height: 1180,
    featured: false,
  },
  {
    src: "/screenshots/04-prometheus-alert-rules.png",
    titleEs: "Prometheus Alert Rules",
    titleEn: "Prometheus Alert Rules",
    categoryEs: "Prometheus · reglas cargadas",
    categoryEn: "Prometheus · loaded rules",
    descriptionEs: "Cuatro reglas de infraestructura y TestIncident aparecen INACTIVE durante el estado normal de la captura.",
    descriptionEn: "Four infrastructure rules and TestIncident appear INACTIVE while the captured lab is in a normal state.",
    altEs: "Captura auténtica de las reglas de Prometheus con cuatro reglas de infraestructura y TestIncident inactivas.",
    altEn: "Authentic Prometheus alert rules screenshot with four infrastructure rules and inactive TestIncident.",
    width: 2559,
    height: 1135,
    featured: false,
  },
  {
    src: "/screenshots/05-alertmanager-no-active-groups.png",
    titleEs: "Alertmanager",
    titleEn: "Alertmanager",
    categoryEs: "Alertmanager · estado normal",
    categoryEn: "Alertmanager · normal state",
    descriptionEs: "No había grupos de alertas activos en el momento de captura; la imagen no representa una falla del servicio.",
    descriptionEn: "There were no active alert groups at capture time; the image does not indicate a service failure.",
    altEs: "Captura auténtica de Alertmanager que indica que no hay grupos de alertas activos.",
    altEn: "Authentic Alertmanager screenshot indicating no active alert groups.",
    width: 2559,
    height: 970,
    featured: false,
  },
  {
    src: "/screenshots/06-github-actions-ci.png",
    titleEs: "GitHub Actions CI",
    titleEn: "GitHub Actions CI",
    categoryEs: "GitHub Actions · cuatro jobs",
    categoryEn: "GitHub Actions · four jobs",
    descriptionEs: "Evidencia visual de la ejecución #4. El enlace CI superior lleva a una ejecución más reciente verificada en main.",
    descriptionEn: "Visual evidence from run #4. The CI link above points to a newer run verified on main.",
    altEs: "Captura auténtica de GitHub Actions con los cuatro jobs de CI en estado exitoso.",
    altEn: "Authentic GitHub Actions screenshot with all four CI jobs successful.",
    width: 2550,
    height: 1114,
    featured: false,
  },
];

const stack = [
  { name: "Prometheus", version: "3.15.0", roleEs: "Scraping, reglas y TSDB", roleEn: "Scraping, rules, and TSDB" },
  { name: "Grafana", version: "13.2.4", roleEs: "Dashboards provisionados", roleEn: "Provisioned dashboards" },
  { name: "Node Exporter", version: "1.12.1", roleEs: "Métricas del Linux del Engine", roleEn: "Docker Engine Linux metrics" },
  { name: "Alertmanager", version: "0.34.1", roleEs: "Agrupación y notificaciones", roleEn: "Alert grouping and delivery" },
  { name: "Incident Logger", version: "Python 3.13", roleEs: "Webhook interno e historial rotado", roleEn: "Internal webhook and rotated history" },
  { name: "Container Exporter", version: "Python 3.10+", roleEs: "Opcional · proceso manual en Windows", roleEn: "Optional · manually started Windows process" },
];

const jobs = [
  { name: "Python 3.10 tests", detailEs: "Pruebas unitarias y scripts PowerShell", detailEn: "Unit tests and PowerShell script parsing" },
  { name: "Python 3.13 tests", detailEs: "Pruebas unitarias y scripts PowerShell", detailEn: "Unit tests and PowerShell script parsing" },
  { name: "Static quality and security checks", detailEs: "Lint, dependencias, higiene y secretos", detailEn: "Lint, dependencies, repository hygiene, and secret scan" },
  { name: "Dashboard and monitoring configuration validation", detailEs: "Dashboards, Compose, Prometheus y Alertmanager", detailEn: "Dashboards, Compose, Prometheus, and Alertmanager" },
];

const docs = [
  { href: `${repositoryDocs}/architecture.md`, labelEs: "Arquitectura", labelEn: "Architecture" },
  { href: `${repositoryDocs}/diagrams.md`, labelEs: "Diagramas actuales", labelEn: "Current diagrams" },
  { href: `${repositoryDocs}/container-exporter.md`, labelEs: "Exporter de contenedores", labelEn: "Container exporter" },
  { href: `${repositoryDocs}/ci.md`, labelEs: "Integración continua", labelEn: "Continuous integration" },
  { href: `${repositoryDocs}/troubleshooting.md`, labelEs: "Troubleshooting", labelEn: "Troubleshooting" },
];

const networkDocs = [
  { href: `${repositoryMain}/docs/home-network-monitoring.md`, labelEs: "Arquitectura y seguridad", labelEn: "Architecture and security" },
  { href: `${repositoryMain}/docs/runbooks/home-network.md`, labelEs: "Runbook técnico", labelEn: "Technical runbook" },
  { href: `${repositoryMain}/docs/incidents/blackbox-exporter-preparation.md`, labelEs: "Informe del incidente", labelEn: "Incident report" },
  { href: `${repositoryMain}/docs/templates/home-network-postmortem.md`, labelEs: "Plantilla de postmortem", labelEn: "Postmortem template" },
  { href: `${repositoryMain}/config/grafana/dashboards/home-network-monitoring.json`, labelEs: "JSON del dashboard", labelEn: "Dashboard JSON" },
  { href: `${repositoryMain}/config/prometheus/rules/home-network.yml`, labelEs: "Reglas de alerta", labelEn: "Alert rules" },
];
---

<!doctype html>
<html lang="es" data-locale="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b1118" />
    <meta name="description" content="IT Infrastructure Monitoring Center: laboratorio DevOps/SRE de observabilidad con Prometheus, Grafana, alertas y evidencia reproducible." />
    <meta property="og:title" content="IT Infrastructure Monitoring Center" />
    <meta property="og:description" content="DevOps & SRE observability portfolio. Evidence from a local monitoring lab; cloud hosting is planned." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/screenshots/01-infrastructure-overview.png" />
    <title>IT Infrastructure Monitoring Center · DevOps &amp; SRE</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main"><span class="lang-es">Saltar al contenido</span><span class="lang-en">Skip to content</span></a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#top" aria-label="IT Infrastructure Monitoring Center">
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="brand-copy"><strong>ITMC</strong><small>OBSERVABILITY LAB</small></span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
          <a href="#overview"><span class="lang-es">Proyecto</span><span class="lang-en">Project</span></a>
          <a href="#architecture"><span class="lang-es">Arquitectura</span><span class="lang-en">Architecture</span></a>
          <a href="#dashboards"><span class="lang-es">Dashboards</span><span class="lang-en">Dashboards</span></a>
          <a href="#real-network"><span class="lang-es">Red real</span><span class="lang-en">Network</span></a>
          <a href="#delivery"><span class="lang-es">CI</span><span class="lang-en">CI</span></a>
          <a href="#roadmap"><span class="lang-es">Roadmap</span><span class="lang-en">Roadmap</span></a>
        </nav>
        <div class="header-actions">
          <div class="locale-switch" role="group" aria-label="Language">
            <button type="button" data-locale-button="es" aria-pressed="true">ES</button>
            <button type="button" data-locale-button="en" aria-pressed="false">EN</button>
          </div>
          <a class="button button-small button-outline" href={repository} target="_blank" rel="noreferrer noopener">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero section" id="top" aria-labelledby="hero-title">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span><span class="lang-es">PORTAFOLIO DEVOPS / SRE · LABORATORIO LOCAL</span><span class="lang-en">DEVOPS / SRE PORTFOLIO · LOCAL LAB</span></p>
            <h1 id="hero-title">IT Infrastructure<br /><span>Monitoring Center</span></h1>
            <p class="hero-kicker">DevOps &amp; SRE Observability Platform</p>
            <p class="hero-description lang-es">Un laboratorio reproducible para observar infraestructura y contenedores, probar el ciclo de alertas y validar configuraciones con evidencia real.</p>
            <p class="hero-description lang-en">A reproducible lab for infrastructure and container observability, alert lifecycle testing, and configuration validation backed by real evidence.</p>
            <div class="hero-tags" aria-label="Project capabilities">
              <span>Prometheus</span><span>Grafana</span><span>Alertmanager</span><span>Docker Compose</span>
            </div>
            <div class="hero-actions">
              <a class="button button-primary" href="#architecture"><span class="lang-es">Explorar arquitectura</span><span class="lang-en">Explore architecture</span><span aria-hidden="true">→</span></a>
              <a class="button button-quiet" href="#dashboards"><span class="lang-es">Ver dashboards</span><span class="lang-en">View dashboards</span><span aria-hidden="true">↓</span></a>
            </div>
            <div class="hero-links">
              <a href={repository} target="_blank" rel="noreferrer noopener"><span class="lang-es">Repositorio GitHub</span><span class="lang-en">GitHub repository</span><span aria-hidden="true">↗</span></a>
              <a href={release} target="_blank" rel="noreferrer noopener">Release v1.0.0 <span aria-hidden="true">↗</span></a>
            </div>
          </div>

          <aside class="hero-console" aria-label="Static architecture summary">
            <div class="console-topline"><span class="console-label"><span class="signal-dot" aria-hidden="true"></span><span class="lang-es">VISTA DEL LABORATORIO</span><span class="lang-en">LAB OVERVIEW</span></span><span class="console-date">EVIDENCE · 24 OCT 2026</span></div>
            <div class="console-title"><div><span class="console-overline"><span class="lang-es">ENTORNO OBSERVADO</span><span class="lang-en">OBSERVED ENVIRONMENT</span></span><strong>Docker Engine Linux</strong></div><span class="console-badge">WSL2</span></div>
            <div class="topology" aria-label="Prometheus receives host and exporter metrics; Grafana visualizes them and Alertmanager forwards incidents to the logger.">
              <div class="topology-source">
                <span class="topology-icon" aria-hidden="true">H</span>
                <span><strong>Linux Engine</strong><small><span class="lang-es">CPU · RAM · disco · red</span><span class="lang-en">CPU · RAM · disk · network</span></small></span>
              </div>
              <div class="topology-arrow" aria-hidden="true"><span></span></div>
              <div class="topology-prom"><span class="topology-icon" aria-hidden="true">P</span><span><strong>Prometheus</strong><small>scrape · rules · TSDB</small></span></div>
              <div class="topology-branches">
                <div class="topology-branch"><span class="branch-line" aria-hidden="true"></span><span class="topology-icon icon-grafana" aria-hidden="true">G</span><span><strong>Grafana</strong><small>14 + 12 panels</small></span></div>
                <div class="topology-branch"><span class="branch-line" aria-hidden="true"></span><span class="topology-icon icon-alert" aria-hidden="true">A</span><span><strong>Alertmanager</strong><small>→ Incident Logger</small></span></div>
              </div>
            </div>
            <div class="console-foot"><span class="lang-es">Evidencia estática, no una conexión en vivo.</span><span class="lang-en">Static evidence, not a live connection.</span><span class="console-foot-line" aria-hidden="true"></span></div>
          </aside>
        </div>
        <div class="container hero-metrics" aria-label="Verified project scope">
          <div><strong>05</strong><span class="lang-es">servicios Compose</span><span class="lang-en">Compose services</span></div>
          <div><strong>02</strong><span class="lang-es">dashboards provisionados</span><span class="lang-en">provisioned dashboards</span></div>
          <div><strong>26</strong><span class="lang-es">paneles Grafana</span><span class="lang-en">Grafana panels</span></div>
          <div><strong>04</strong><span class="lang-es">jobs CI validados en main</span><span class="lang-en">CI jobs verified on main</span></div>
          <p><span class="lang-es">Alcance basado en configuración y evidencia; no son contadores en vivo.</span><span class="lang-en">Scope from configuration and evidence; these are not live counters.</span></p>
        </div>
      </section>

      <section class="section section-border" id="overview" aria-labelledby="overview-title">
        <div class="container">
          <div class="section-heading"><div><p class="section-index">01 / PROJECT OVERVIEW</p><h2 id="overview-title"><span class="lang-es">Observar. Alertar. Aprender.</span><span class="lang-en">Observe. Alert. Learn.</span></h2></div><p class="section-intro lang-es">El proyecto conecta métricas de infraestructura con visibilidad operativa, pruebas controladas de incidentes y validaciones repetibles.</p><p class="section-intro lang-en">The project connects infrastructure metrics to operational visibility, controlled incident tests, and repeatable validation.</p></div>
          <div class="capability-grid">
            <article class="capability-card"><span class="card-number">01</span><h3><span class="lang-es">Visibilidad de infraestructura</span><span class="lang-en">Infrastructure visibility</span></h3><p class="lang-es">CPU, memoria, filesystem, red, uptime y disponibilidad de targets a través de Prometheus y Node Exporter.</p><p class="lang-en">CPU, memory, filesystem, network, uptime, and target availability through Prometheus and Node Exporter.</p></article>
            <article class="capability-card"><span class="card-number">02</span><h3><span class="lang-es">Observación por contenedor</span><span class="lang-en">Per-container observation</span></h3><p class="lang-es">Un proceso Python opcional obtiene snapshots del Docker CLI en el host Windows, filtrados por etiqueta Compose.</p><p class="lang-en">An optional Python process collects Docker CLI snapshots on the Windows host, filtered by Compose project label.</p></article>
            <article class="capability-card"><span class="card-number">03</span><h3><span class="lang-es">Ciclo de incidentes</span><span class="lang-en">Incident lifecycle</span></h3><p class="lang-es">Reglas Prometheus, agrupación de Alertmanager y registro persistente de notificaciones FIRING y RESOLVED.</p><p class="lang-en">Prometheus rules, Alertmanager grouping, and persistent logging of FIRING and RESOLVED notifications.</p></article>
            <article class="capability-card"><span class="card-number">04</span><h3><span class="lang-es">Validación reproducible</span><span class="lang-en">Repeatable validation</span></h3><p class="lang-es">Pruebas unitarias y comprobaciones estáticas en runners de GitHub Actions, sin depender de Docker Desktop.</p><p class="lang-en">Unit tests and static checks on GitHub Actions runners, independent of Docker Desktop.</p></article>
          </div>

          <div class="stack-heading"><div><p class="section-index">IMPLEMENTED STACK</p><h3><span class="lang-es">Tecnologías del repositorio</span><span class="lang-en">Technologies in the repository</span></h3></div><span class="status-pill status-implemented"><span class="status-led" aria-hidden="true"></span><span class="lang-es">Implementado</span><span class="lang-en">Implemented</span></span></div>
          <div class="stack-grid">
            {stack.map((item, index) => (
              <article class="stack-card"><div class="stack-card-top"><span class="stack-index">0{index + 1}</span><span class="stack-version">{item.version}</span></div><h4>{item.name}</h4><p class="lang-es">{item.roleEs}</p><p class="lang-en">{item.roleEn}</p></article>
            ))}
          </div>
          <p class="note-line"><span class="note-symbol" aria-hidden="true">i</span><span class="lang-es"><strong>Alcance del host:</strong> CPU, RAM, red y uptime de Node Exporter representan el Linux que ve Docker Engine/WSL2, no el Windows físico.</span><span class="lang-en"><strong>Host scope:</strong> Node Exporter CPU, memory, network, and uptime describe the Linux environment visible to Docker Engine/WSL2, not physical Windows.</span></p>
        </div>
      </section>

      <section class="section section-border" id="dashboards" aria-labelledby="dashboards-title">
        <div class="container">
          <div class="section-heading"><div><p class="section-index">02 / DASHBOARD GALLERY</p><h2 id="dashboards-title"><span class="lang-es">Evidencia de observabilidad</span><span class="lang-en">Observability evidence</span></h2></div><p class="section-intro lang-es">Seis capturas auténticas del laboratorio. Los números reflejan el instante capturado; no son métricas actuales ni una demo cloud en vivo.</p><p class="section-intro lang-en">Six authentic lab screenshots. Values reflect their capture time; they are not current metrics or a live cloud demo.</p></div>
          <div class="gallery-grid">
            {screenshots.map((item, index) => (
              <article class:list={["gallery-card", item.featured && "gallery-featured"]}>
                <button class="gallery-image-button" type="button" data-open-image data-image-src={item.src} data-image-alt-es={item.altEs} data-image-alt-en={item.altEn} data-image-caption-es={`${item.titleEs} — ${item.descriptionEs}`} data-image-caption-en={`${item.titleEn} — ${item.descriptionEn}`} data-aria-es={`Ampliar captura: ${item.titleEs}`} data-aria-en={`Open screenshot: ${item.titleEn}`}>
                  <img src={item.src} alt={item.altEs} width={item.width} height={item.height} loading={index < 2 ? "eager" : "lazy"} decoding="async" />
                  <span class="image-open-mark" aria-hidden="true">↗</span>
                </button>
                <div class="gallery-copy"><div class="gallery-meta"><span class="lang-es">{item.categoryEs}</span><span class="lang-en">{item.categoryEn}</span><span>0{index + 1}</span></div><h3>{item.titleEs}</h3><p class="lang-es">{item.descriptionEs}</p><p class="lang-en">{item.descriptionEn}</p></div>
              </article>
            ))}
          </div>
          <div class="gallery-footnote"><span class="footnote-mark" aria-hidden="true">↗</span><p class="lang-es">Las capturas provienen de `screenshots/` y se incluyen sin recorte ni alteración de datos. Usa el visor accesible para ampliarlas.</p><p class="lang-en">Screenshots come from `screenshots/` and are included without cropping or changing their data. Use the accessible viewer to inspect them.</p></div>
        </div>
      </section>

      <section class="section section-border" id="real-network" aria-labelledby="real-network-title">
        <div class="container">
          <div class="section-heading"><div><p class="section-index">03 / REAL-WORLD NETWORK MONITORING</p><h2 id="real-network-title"><span class="lang-es">Monitoreo de red real</span><span class="lang-en">Real-World Network Monitoring</span></h2></div><p class="section-intro lang-es">ITMC pasó de validar un laboratorio de observabilidad a aplicar las mismas señales en una red doméstica bajo administración de su propietario.</p><p class="section-intro lang-en">ITMC evolved from validating an observability lab to applying the same signals to an owner-managed home network.</p></div>

          <div class="network-showcase">
            <article class="network-summary">
              <p class="network-eyebrow"><span class="status-led" aria-hidden="true"></span><span class="lang-es">EVIDENCIA LOCAL · VALIDADA</span><span class="lang-en">LOCAL EVIDENCE · VERIFIED</span></p>
              <h3><span class="lang-es">Una ruta de observación por capas</span><span class="lang-en">Layered network observability</span></h3>
              <p class="network-summary-copy lang-es">Blackbox Exporter ejecuta sondas desde la red Linux de Docker Desktop/WSL2. La web es estática: documenta evidencia real, no consulta la red ni muestra telemetría en vivo.</p>
              <p class="network-summary-copy lang-en">Blackbox Exporter runs probes from Docker Desktop/WSL2 Linux networking. This site is static: it presents real evidence, does not query the network, and shows no live telemetry.</p>
              <div class="network-stats" aria-label="Verified project scope">
                <div><strong>05</strong><span class="lang-es">sondas verificadas</span><span class="lang-en">verified probes</span></div>
                <div><strong>13</strong><span class="lang-es">paneles Grafana</span><span class="lang-en">Grafana panels</span></div>
                <div><strong>07</strong><span class="lang-es">reglas de alerta</span><span class="lang-en">alert rules</span></div>
              </div>
              <p class="network-scope-note"><span class="footnote-mark" aria-hidden="true">i</span><span class="lang-es">Son características verificadas del laboratorio, no indicadores dinámicos de disponibilidad actual.</span><span class="lang-en">These are verified lab capabilities, not dynamic indicators of current availability.</span></p>
            </article>

            <article class="network-capture-card">
              <button class="network-capture-button" type="button" data-open-image data-image-src="/screenshots/07-home-network-monitoring.png" data-image-alt-es="Captura auténtica del dashboard Home Network Monitoring: cinco sondas, gráficas de latencia y disponibilidad, y estado saludable de Blackbox Exporter." data-image-alt-en="Authentic Home Network Monitoring dashboard screenshot: five probes, latency and availability charts, and healthy Blackbox Exporter." data-image-caption-es="Home Network Monitoring — captura real proporcionada por el propietario; evidencia estática, sin modificación de valores." data-image-caption-en="Home Network Monitoring — authentic capture supplied by the owner; static evidence with values unchanged." data-aria-es="Ampliar captura del dashboard Home Network Monitoring" data-aria-en="Open the Home Network Monitoring dashboard screenshot">
                <img src="/screenshots/07-home-network-monitoring.png" alt="Captura auténtica del dashboard Home Network Monitoring con estado de router, sondas externas y exporter; evidencia estática." width="2559" height="1306" loading="lazy" decoding="async" />
                <span class="image-open-mark" aria-hidden="true">↗</span>
              </button>
              <div class="network-capture-caption"><div><strong>Home Network Monitoring</strong><span class="lang-es">Grafana · 13 paneles</span><span class="lang-en">Grafana · 13 panels</span></div><span class="capture-label"><span class="lang-es">CAPTURA AUTÉNTICA</span><span class="lang-en">AUTHENTIC CAPTURE</span></span></div>
            </article>
          </div>

          <div class="network-probes-grid" aria-label="Probe types">
            <article class="network-probe-card"><span class="network-probe-code">01 / ICMP</span><h3><span class="lang-es">Router doméstico</span><span class="lang-en">Home router</span></h3><p class="lang-es">Comprobación de alcance al gateway configurado localmente.</p><p class="lang-en">Reachability check to the locally configured gateway.</p></article>
            <article class="network-probe-card"><span class="network-probe-code">02 / ICMP</span><h3><span class="lang-es">Conectividad externa</span><span class="lang-en">External reachability</span></h3><p class="lang-es">Sonda a un destino externo expresamente aprobado; no representa por sí sola toda la conexión a Internet.</p><p class="lang-en">Probe to an explicitly approved external endpoint; it does not alone represent all Internet connectivity.</p></article>
            <article class="network-probe-card"><span class="network-probe-code">03 / DNS A</span><h3><span class="lang-es">Resolución IPv4</span><span class="lang-en">IPv4 resolution</span></h3><p class="lang-es">Consulta DNS del registro A para el dominio de prueba configurado.</p><p class="lang-en">DNS lookup for the configured test domain's A record.</p></article>
            <article class="network-probe-card"><span class="network-probe-code">04 / DNS AAAA</span><h3><span class="lang-es">Resolución IPv6</span><span class="lang-en">IPv6 resolution</span></h3><p class="lang-es">Consulta separada del registro AAAA, con estado propio.</p><p class="lang-en">Separate AAAA record lookup with its own status.</p></article>
            <article class="network-probe-card"><span class="network-probe-code">05 / HTTPS</span><h3><span class="lang-es">Servicio web externo</span><span class="lang-en">External HTTPS service</span></h3><p class="lang-es">Conexión TLS a un endpoint fijo, sin seguir redirecciones a otros destinos.</p><p class="lang-en">TLS connection to a fixed endpoint, without following redirects to other destinations.</p></article>
            <article class="network-probe-card network-probe-exporter"><span class="network-probe-code">OBSERVABILITY</span><h3>Blackbox Exporter</h3><p class="lang-es">Su estado confirma el scrape del componente, no la disponibilidad de los destinos.</p><p class="lang-en">Its status confirms component scraping, not destination availability.</p></article>
          </div>

          <article class="network-incident-card">
            <div class="network-incident-main"><p class="network-eyebrow"><span class="network-incident-led" aria-hidden="true"></span><span class="lang-es">CICLO DE INCIDENTE DOCUMENTADO</span><span class="lang-en">DOCUMENTED INCIDENT LIFECYCLE</span></p><h3>BlackboxExporterDown</h3><div class="network-incident-flow"><span>FIRING</span><span aria-hidden="true">→</span><span>RESOLVED</span><strong>25 min 15 s</strong></div></div>
            <p class="network-incident-copy lang-es">Incidente de preparación: se confirmó la interrupción y recuperación del scrape de Blackbox, no una caída del ISP. La causa específica quedó sin confirmar; durante parte del intervalo no hubo muestras para determinar la conectividad externa.</p>
            <p class="network-incident-copy lang-en">Preparation incident: the Blackbox scrape interruption and recovery were confirmed, not an ISP outage. The specific cause remains unconfirmed; part of the interval had no samples to determine external connectivity.</p>
          </article>

          <div class="network-limitations">
            <div><h3><span class="lang-es">Límites de esta evidencia</span><span class="lang-en">Evidence boundaries</span></h3><p class="lang-es">El monitoreo es local y depende de Windows y Docker Desktop/WSL2 encendidos. El portal muestra capturas, no métricas en vivo. El laboratorio doméstico no está desplegado en Oracle Cloud; las IP, MAC, SSID y targets privados se mantienen fuera del repositorio.</p><p class="lang-en">Monitoring runs locally and depends on Windows and Docker Desktop/WSL2 staying on. This portal shows screenshots, not live metrics. The home lab is not deployed to Oracle Cloud; private IPs, MACs, SSIDs, and targets stay out of the repository.</p></div>
            <nav class="network-doc-links" aria-label="Home Network Monitoring documentation">{networkDocs.map((doc) => <a href={doc.href} target="_blank" rel="noreferrer noopener"><span class="lang-es">{doc.labelEs}</span><span class="lang-en">{doc.labelEn}</span><span aria-hidden="true">↗</span></a>)}</nav>
          </div>
        </div>
      </section>

      <section class="section section-border" id="architecture" aria-labelledby="architecture-title">
        <div class="container">
          <div class="section-heading"><div><p class="section-index">04 / ARCHITECTURE</p><h2 id="architecture-title"><span class="lang-es">Dos entornos, sin confundirlos</span><span class="lang-en">Two environments, clearly separated</span></h2></div><p class="section-intro lang-es">La solución actual es local. La arquitectura cloud está en diseño y no se ha desplegado ni conectado a este host.</p><p class="section-intro lang-en">The current solution is local. The cloud architecture is under design and has not been deployed or connected to this host.</p></div>
          <div class="architecture-grid">
            <article class="architecture-card architecture-current">
              <div class="architecture-card-top"><span class="architecture-number">A</span><span class="status-pill status-implemented"><span class="status-led" aria-hidden="true"></span><span class="lang-es">Actual · implementado</span><span class="lang-en">Current · implemented</span></span></div>
              <h3><span class="lang-es">Windows + Docker Desktop / WSL2</span><span class="lang-en">Windows + Docker Desktop / WSL2</span></h3>
              <p class="lang-es">Node Exporter observa el Linux del Engine. Prometheus scrapea Node Exporter y sus reglas; Grafana consume Prometheus; Alertmanager reenvía incidentes al logger interno.</p>
              <p class="lang-en">Node Exporter observes Engine Linux. Prometheus scrapes Node Exporter and evaluates rules; Grafana reads Prometheus; Alertmanager sends incidents to the internal logger.</p>
              <div class="architecture-flow" aria-label="Current local metrics and alert flow">
                <div class="flow-row"><span class="flow-node">Node Exporter</span><span class="flow-arrow" aria-hidden="true">→</span><span class="flow-node flow-node-prom">Prometheus</span><span class="flow-arrow" aria-hidden="true">→</span><span class="flow-node flow-node-graf">Grafana</span></div>
                <div class="flow-row flow-secondary"><span class="flow-node">Prometheus rules</span><span class="flow-arrow" aria-hidden="true">→</span><span class="flow-node flow-node-alert">Alertmanager</span><span class="flow-arrow" aria-hidden="true">→</span><span class="flow-node">Incident Logger</span></div>
                <div class="flow-row flow-exporter"><span class="flow-node">Windows Docker CLI</span><span class="flow-arrow" aria-hidden="true">→</span><span class="flow-node">Python exporter</span><span class="flow-connection"><span>host.docker.internal</span><span aria-hidden="true">→</span></span><span class="flow-node flow-node-prom">Prometheus</span></div>
              </div>
              <p class="architecture-foot"><span class="footnote-mark" aria-hidden="true">!</span><span class="lang-es">Ningún contenedor monta el socket Docker. El exporter en Windows conserva acceso significativo al daemon.</span><span class="lang-en">No container mounts the Docker socket. The Windows exporter retains significant daemon access.</span></p>
            </article>
            <article class="architecture-card architecture-planned">
              <div class="architecture-card-top"><span class="architecture-number">B</span><span class="status-pill status-planned"><span class="status-led" aria-hidden="true"></span><span class="lang-es">Propuesto · no desplegado</span><span class="lang-en">Proposed · not deployed</span></span></div>
              <h3><span class="lang-es">OCI ARM64 + Cloudflare Pages</span><span class="lang-en">OCI ARM64 + Cloudflare Pages</span></h3>
              <p class="lang-es">El portal estático vive por separado del laboratorio. En OCI, un reverse proxy sería la única entrada web; los servicios de métricas quedarían en redes privadas.</p>
              <p class="lang-en">The static portfolio is separate from the lab. On OCI, a reverse proxy would be the only web ingress; monitoring services stay on private networks.</p>
              <div class="architecture-flow planned-flow" aria-label="Proposed cloud architecture">
                <div class="flow-row"><span class="flow-node flow-node-cloud">Cloudflare Pages</span><span class="flow-note"><span class="lang-es">portal estático</span><span class="lang-en">static portfolio</span></span></div>
                <div class="planned-separator"><span>INDEPENDENT</span></div>
                <div class="flow-row"><span class="flow-node flow-node-cloud">HTTPS :443</span><span class="flow-arrow" aria-hidden="true">→</span><span class="flow-node">Reverse proxy</span><span class="flow-arrow" aria-hidden="true">→</span><span class="flow-node flow-node-graf">Grafana</span></div>
                <div class="flow-row flow-secondary"><span class="flow-node flow-node-prom">Prometheus</span><span class="flow-note"><span class="lang-es">scrape privado</span><span class="lang-en">private scrape</span></span><span class="flow-node">Node Exporter</span><span class="flow-arrow" aria-hidden="true">→</span><span class="flow-node flow-node-alert">Alertmanager</span></div>
              </div>
              <p class="architecture-foot"><span class="footnote-mark" aria-hidden="true">!</span><span class="lang-es">El exporter Linux por contenedor queda fuera de la línea base hasta aprobar un límite de permisos seguro.</span><span class="lang-en">Per-container Linux exporter stays out of the baseline until a safe privilege boundary is approved.</span></p>
            </article>
          </div>
          <a class="text-link" href={`${repositoryDocs}/cloud/architecture.md`} target="_blank" rel="noreferrer noopener"><span class="lang-es">Leer arquitectura propuesta y diagramas Mermaid</span><span class="lang-en">Read the proposed architecture and Mermaid diagrams</span><span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="section section-border" id="incidents" aria-labelledby="incidents-title">
        <div class="container">
          <div class="section-heading"><div><p class="section-index">05 / INCIDENT LIFECYCLE</p><h2 id="incidents-title"><span class="lang-es">Del síntoma a la recuperación</span><span class="lang-en">From signal to recovery</span></h2></div><p class="section-intro lang-es">La simulación controlada verifica el flujo de reglas y notificaciones, sin presentar tiempos como un SLO de producción.</p><p class="section-intro lang-en">Controlled simulations validate alert and notification flow without presenting timings as a production SLO.</p></div>
          <ol class="incident-lifecycle">
            <li><span class="lifecycle-index">01</span><strong>NORMAL</strong><p class="lang-es">Métricas dentro de umbral</p><p class="lang-en">Metrics within thresholds</p></li>
            <li><span class="lifecycle-index">02</span><strong>PENDING</strong><p class="lang-es">Condición sostenida</p><p class="lang-en">Condition sustained</p></li>
            <li><span class="lifecycle-index">03</span><strong>FIRING</strong><p class="lang-es">Regla activa</p><p class="lang-en">Rule is active</p></li>
            <li><span class="lifecycle-index">04</span><strong>NOTIFICATION</strong><p class="lang-es">Alertmanager → logger</p><p class="lang-en">Alertmanager → logger</p></li>
            <li><span class="lifecycle-index">05</span><strong>RESOLVED</strong><p class="lang-es">Recuperación registrada</p><p class="lang-en">Recovery recorded</p></li>
          </ol>
          <div class="incident-note"><span class="status-led" aria-hidden="true"></span><p class="lang-es"><strong>TestIncident permanece inactiva por defecto.</strong> Las capturas muestran un laboratorio en estado normal y sin grupos de alertas activos.</p><p class="lang-en"><strong>TestIncident stays inactive by default.</strong> The screenshots show the lab in a normal state with no active alert groups.</p></div>
        </div>
      </section>

